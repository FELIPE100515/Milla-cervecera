---
import Layout from "../layouts/Layout.astro";
---

<Layout title="La Milla Cervecera - Polafest">
  <link rel="preload" href="/hero.webp" as="image" type="image/webp" fetchpriority="high" slot="head" />

  <!-- Navigation -->
  <nav
    class="bg-[#fff9ee] w-full top-0 sticky z-40 border-b-4 border-[#a04100] shadow-[4px_4px_0px_0px_rgba(160,65,0,1)] flex justify-between items-center px-5 md:px-16 py-4"
  >
    <a class="flex items-center" href="#" aria-label="Inicio - La Milla Cervecera">
      <img
        src="/logosf.webp"
        alt="La Milla Cervecera Logo"
        width="492"
        height="366"
        loading="eager"
        decoding="async"
        class="h-12 w-auto object-contain hover:skew-x-[-10deg] transition-transform"
      />
    </a>
    
    <div class="flex items-center gap-4">
      <a
        href="https://www.instagram.com/lapolafest/"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#ff6b00] px-3 py-2 sm:px-5 sm:py-1.5 hard-shadow-primary hover:translate-y-1 hover:shadow-none transition-all duration-100 slanted flex items-center justify-center"
        aria-label="Instagram Polafest"
      >
        <img
          src="/polafest_logo.webp"
          alt="Polafest"
          width="2000"
          height="827"
          loading="eager"
          decoding="async"
          class="h-6 sm:h-8 w-auto object-contain un-slanted brightness-0 invert"
        />
      </a>
      <a
        href="https://quickticket.com.co/event/735168ef-62c7-4e58-8fa2-6bc5e1344129?fbclid=PAcGRvZgRleHRuA2FlbQIxMQBzcnRjBmFwcF9pZAwyNTYyODEwNDA1NTgAAaetVql81B_FNZBYgL2ud6LBXwRpZJA1FBrXCoxWDr7gISamrlus_NEXiZ0mzw_aem_GMWJ_Qg1F2b3h6Wyc1UJjA"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#096c4b] text-white font-['Anton'] text-xs sm:text-lg px-4 py-2.5 sm:px-6 sm:py-2 uppercase tracking-wide hard-shadow-primary hover:translate-y-1 hover:shadow-none transition-all duration-100 slanted block text-center"
      >
        <span class="block un-slanted">REGISTRARSE</span>
      </a>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-5 md:px-16 py-8 relative z-10 space-y-24">
    <!-- Hero Section -->
    <section
      class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[70vh] relative"
    >
      <!-- Decorative Pattern -->
      <div
        class="absolute inset-0 leopard-pattern -z-10 w-full h-[80vh] top-0 left-0"
      >
      </div>

      <div
        class="col-span-1 md:col-span-6 space-y-6 flex flex-col justify-center items-center md:items-start"
      >
        <div
          class="inline-block bg-[#ff6b00] text-[#572000] px-4 py-1 skew-x-[-10deg] hard-shadow-primary w-fit max-w-full mb-4"
        >
          <span
            class="font-['Anton'] text-sm sm:text-lg uppercase italic block skew-x-[10deg] break-words"
            >BUCARAMANGA / POLAFEST VII EDICIÓN</span
          >
        </div>

        <h1 class="mb-4">
          <span class="sr-only">La Milla Cervecera</span>
          <img
            src="/logosf.webp"
            alt="La Milla Cervecera"
            width="492"
            height="366"
            loading="eager"
            decoding="async"
            class="h-32 md:h-48 w-auto object-contain hover:scale-105 transition-transform duration-200"
          />
        </h1>

        <div class="grid grid-cols-2 md:flex md:flex-wrap gap-4 mt-8">
          <div
            class="bg-[#096c4b] text-white p-4 flex flex-col items-center justify-center hard-shadow-primary col-span-1 md:w-32 rotate-[-3deg]"
          >
            <span class="font-['Space_Grotesk'] text-base uppercase opacity-80 font-bold"
              >Fecha</span
            >
            <span class="font-['Anton'] text-3xl uppercase">13 SEP</span>
          </div>
          <div
            class="bg-[#096c4b] text-white p-4 flex flex-col items-center justify-center hard-shadow-primary col-span-1 md:w-32 rotate-[2deg]"
          >
            <span class="font-['Space_Grotesk'] text-base uppercase opacity-80 font-bold"
              >Valor</span
            >
            <span class="font-['Anton'] text-3xl uppercase">120K</span>
          </div>
          <div
            class="bg-[#ff6b00] text-[#572000] p-4 flex flex-col items-center justify-center hard-shadow-primary col-span-2 md:flex-1 md:min-w-[200px] skew-x-[-5deg]"
          >
            <span
              class="font-['Space_Grotesk'] text-base uppercase opacity-80 font-bold skew-x-[5deg] block"
              >Distancia</span
            >
            <span
              class="font-['Anton'] text-3xl uppercase skew-x-[5deg] block italic"
              >3 KM</span
            >
          </div>
        </div>

        <div class="mt-8">
          <a
            href="https://quickticket.com.co/event/735168ef-62c7-4e58-8fa2-6bc5e1344129?fbclid=PAcGRvZgRleHRuA2FlbQIxMQBzcnRjBmFwcF9pZAwyNTYyODEwNDA1NTgAAaetVql81B_FNZBYgL2ud6LBXwRpZJA1FBrXCoxWDr7gISamrlus_NEXiZ0mzw_aem_GMWJ_Qg1F2b3h6Wyc1UJjA"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#096c4b] text-white font-['Anton'] text-2xl px-12 py-4 uppercase tracking-wide hard-shadow-primary hover:translate-y-1 hover:shadow-none transition-all duration-100 w-full md:w-auto text-center slanted block"
          >
            <span class="block un-slanted">INSCRIBETE AHORA</span>
          </a>
        </div>
      </div>

      <div
        class="col-span-1 md:col-span-6 relative"
      >
        <!-- Main athletic image -->
        <img
          alt="Corredor La Milla"
          width="668"
          height="889"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto grayscale-[20%] contrast-125 sepia-[10%] hard-shadow-primary border-4 border-white"
          src="/hero.webp"
        />

        <!-- Finisher medal graphic -->
        <div
          class="absolute -bottom-4 -right-2 md:-bottom-6 md:-right-6 bg-[#fff9ee] p-4 border-4 border-[#a04100] hard-shadow-primary rotate-12 z-20"
        >
          <img
            alt="Vista previa de la medalla de finalista"
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
            class="w-24 h-auto"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQzOHm08NWPdcpyIrjFj5uWFRNamf36g0OHkrYSolqTKWuto8zAoNefFeItdhup8LuViRSUFwUkyVn0Mdu-aMOV7liAZH3fSf1IJPpZ4gKOVIRk_4MRkCXVbT0ob_AEDO2VyLIz4_Wiy9uwDsQ29IxXTafUMczmnC9MWLY7Godr5nzB1ueX3vI3zjTpDmo2YUPkhfZSoyA36a8rLLL2hY33Kr8vN5hDgj0wfAS2SEXbRSwhw1476wy"
          />
        </div>
      </div>
    </section>

    <!-- Event Details (Bento Grid) -->
    <section class="py-12" id="ruta">
      <div class="text-center md:text-left">
        <h2
          class="font-['Anton'] text-3xl md:text-4xl text-[#a04100] uppercase italic mb-8 inline-block bg-[#f4edde] px-6 py-2 hard-shadow-primary skew-x-[-5deg]"
        >
          LA CARRERA MÁS BACANA
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div
          class="bg-[#096c4b] text-white p-8 border-4 border-[#a04100] hard-shadow-primary relative overflow-hidden group hover:-translate-y-2 transition-all duration-300 text-center md:text-left"
        >
          <div
            class="absolute -right-4 -top-4 opacity-10 group-hover:scale-110 transition-transform duration-500"
          >
            <span
              class="material-symbols-outlined text-[120px]"
              style="font-variation-settings: 'FILL' 1;">sprint</span
            >
          </div>
          <h3
            class="font-['Anton'] text-2xl uppercase italic mb-4 relative z-10"
          >
            CORRE 3KM
          </h3>
          <p
            class="font-['Archivo_Narrow'] text-lg relative z-10 text-white/90"
          >
            Una ruta diseñada para disfrutar. No importa tu ritmo, lo importante
            es llegar a la meta y celebrar.
          </p>
        </div>
        <!-- Card 2 -->
        <div
          class="bg-[#ff6b00] text-[#572000] p-8 border-4 border-[#a04100] hard-shadow-primary relative overflow-hidden group hover:-translate-y-2 transition-all duration-300 text-center md:text-left"
        >
          <div
            class="absolute -right-4 -top-4 opacity-10 group-hover:scale-110 transition-transform duration-500"
          >
            <span
              class="material-symbols-outlined text-[120px]"
              style="font-variation-settings: 'FILL' 1;">sports_bar</span
            >
          </div>
          <h3
            class="font-['Anton'] text-2xl uppercase italic mb-4 relative z-10"
          >
            CELEBRA EN POLAFEST
          </h3>
          <p
            class="font-['Archivo_Narrow'] text-lg relative z-10 text-[#572000]/90"
          >
            Tu inscripción te da acceso directo al festival de cerveza artesanal
            más grande de la ciudad. ¡Salud por el esfuerzo!
          </p>
        </div>
        <!-- Card 3 -->
        <div
          class="bg-[#eee8d9] text-[#1e1b12] p-8 border-4 border-[#a04100] hard-shadow-primary relative overflow-hidden group hover:-translate-y-2 transition-all duration-300 text-center md:text-left"
        >
          <div
            class="absolute -right-4 -top-4 opacity-10 text-[#a04100] group-hover:scale-110 transition-transform duration-500"
          >
            <span
              class="material-symbols-outlined text-[120px]"
              style="font-variation-settings: 'FILL' 1;">groups</span
            >
          </div>
          <h3
            class="font-['Anton'] text-2xl uppercase italic text-[#a04100] mb-4 relative z-10"
          >
            PARCHE COMPLETO
          </h3>
          <p class="font-['Archivo_Narrow'] text-lg relative z-10">
            Música en vivo, gastronomía local y el mejor ambiente. Arma tu grupo
            de corredores y vivan la experiencia juntos.
          </p>
        </div>
      </div>
    </section>

    <!-- Recorrido (Mapa) Section -->
    <section
      class="py-12"
      id="recorrido"
    >
      <div class="text-center md:text-left">
        <h2
          class="font-['Anton'] text-3xl md:text-4xl text-[#a04100] uppercase italic mb-8 inline-block bg-[#f4edde] px-6 py-2 hard-shadow-primary skew-x-[-5deg]"
        >
          EL RECORRIDO
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <!-- Map Container -->
        <div
          class="md:col-span-8 bg-[#fff9ee] border-4 border-[#a04100] hard-shadow-primary p-2 overflow-hidden"
        >
          <img
            alt="Mapa del recorrido 3K"
            width="999"
            height="1575"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover contrast-125 grayscale-[10%]"
            src="/mapa.webp"
          />
        </div>
        <!-- Route Details -->
        <div class="md:col-span-4 space-y-6">
          <div
            class="bg-[#096c4b] text-white p-6 hard-shadow-primary skew-x-[-2deg] text-center md:text-left"
          >
            <div class="flex items-center justify-center md:justify-start gap-2 mb-2">
              <span class="material-symbols-outlined text-[#ff6b00]">flag</span>
              <h3 class="font-['Space_Grotesk'] text-sm uppercase opacity-80 font-bold">
                Punto de Partida
              </h3>
            </div>
            <p class="font-['Anton'] text-2xl uppercase italic leading-none">
              Pista de Atletismo Américo Montanini
            </p>
          </div>
          <div
            class="bg-[#ff6b00] text-[#572000] p-6 hard-shadow-primary rotate-[1deg] text-center md:text-left"
          >
            <div class="flex items-center justify-center md:justify-start gap-2 mb-2">
              <span class="material-symbols-outlined">sports_score</span>
              <h3 class="font-['Space_Grotesk'] text-sm uppercase opacity-80 font-bold">
                Meta
              </h3>
            </div>
            <p class="font-['Anton'] text-2xl uppercase italic leading-none">
              Tarima Polafest
            </p>
          </div>
          <div
            class="bg-[#eee8d9] text-[#1e1b12] p-6 border-4 border-[#a04100] hard-shadow-primary text-center md:text-left"
          >
            <h3
              class="font-['Space_Grotesk'] text-sm uppercase text-[#a04100] mb-4 font-bold"
            >
              Detalles de la Ruta
            </h3>
            <ul class="space-y-3 font-['Archivo_Narrow'] text-lg">
              <li class="flex items-start justify-center md:justify-start gap-2">
                <span
                  class="material-symbols-outlined text-[#096c4b] text-sm mt-1"
                  >circle</span
                >
                <span
                  >1. Salida desde la pista atlética hacia la <strong
                    >Calle 14</strong
                  >.</span
                >
              </li>
              <li class="flex items-start justify-center md:justify-start gap-2">
                <span
                  class="material-symbols-outlined text-[#096c4b] text-sm mt-1"
                  >circle</span
                >
                <span
                  >2. Giro por la <strong>Carrera 27</strong> hacia la <strong
                    >Calle 11</strong
                  >.</span
                >
              </li>
              <li class="flex items-start justify-center md:justify-start gap-2">
                <span
                  class="material-symbols-outlined text-[#096c4b] text-sm mt-1"
                  >circle</span
                >
                <span
                  >3. Retorno hacia la plazoleta del <strong
                    >Américo Montanini</strong
                  >, rodeando el estadio completamente.</span
                >
              </li>
              <li class="flex items-start justify-center md:justify-start gap-2">
                <span
                  class="material-symbols-outlined text-[#096c4b] text-sm mt-1"
                  >circle</span
                >
                <span
                  >4. Llegada hasta la <strong
                    >tarima principal del Polafest</strong
                  >.</span
                >
              </li>
            </ul>
            <div class="mt-6 pt-4 border-t-2 border-dashed border-[#a04100]/30">
              <span class="font-['Anton'] text-2xl text-[#a04100] italic"
                >DISTANCIA 3K</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Kit Section -->
    <section class="py-12 relative" id="kit">
      <div
        class="bg-[#096c4b] text-white p-8 border-4 border-[#a04100] hard-shadow-primary relative z-10"
      >
        <div class="flex flex-col md:flex-row gap-8 items-start">
          <!-- Text/List Side -->
          <div class="w-full md:w-1/3">
            <div class="text-center md:text-left">
              <div
                class="bg-[#fff9ee] text-[#096c4b] inline-block px-4 py-2 skew-x-[-10deg] mb-6 border-2 border-[#096c4b]"
              >
                <h2
                  class="font-['Anton'] text-3xl uppercase italic skew-x-[10deg] tracking-tighter m-0 leading-none whitespace-nowrap"
                >
                  INCLUYE KIT
                </h2>
              </div>
            </div>
            <ul class="space-y-4 font-['Anton'] text-2xl uppercase italic">
              <li
                class="flex items-center justify-center md:justify-start gap-2 border-b-2 border-dashed border-[#84d7ae] pb-2"
              >
                <span class="material-symbols-outlined text-[#ff6b00]"
                  >star</span
                > MEDALLA ICÓNICA OFICIAL
              </li>
              <li
                class="flex items-center justify-center md:justify-start gap-2 border-b-2 border-dashed border-[#84d7ae] pb-2"
              >
                <span class="material-symbols-outlined text-[#ff6b00]"
                  >apparel</span
                > CAMISETA OFICIAL
              </li>
              <li
                class="flex items-center justify-center md:justify-start gap-2 border-b-2 border-dashed border-[#84d7ae] pb-2"
              >
                <span class="material-symbols-outlined text-[#ff6b00]">tag</span
                > DORSAL
              </li>
              <li
                class="flex items-center justify-center md:justify-start gap-2 border-b-2 border-dashed border-[#84d7ae] pb-2"
              >
                <span class="material-symbols-outlined text-[#ff6b00]"
                  >water_bottle</span
                > TERMO
              </li>
              <li class="flex items-center justify-center md:justify-start gap-2">
                <span class="material-symbols-outlined text-[#ff6b00]"
                  >backpack</span
                > TULA
              </li>
            </ul>
            <p
              class="font-['Space_Grotesk'] text-xs mt-6 text-white/70 max-w-sm mx-auto md:mx-0 text-center md:text-left"
            >
              *El contenido final del kit de carrera está sujeto a cambios por
              parte de los patrocinadores y marcas aliadas. Próximamente
              brindaremos la información detallada de todos los componentes del
              kit.
            </p>
          </div>
          <!-- Image Side -->
          <div class="w-full md:w-2/3 flex items-center justify-center bg-[#fff9ee] p-4 border-4 border-[#ff6b00] hard-shadow-primary relative overflow-hidden group hover:-translate-y-1 transition-all duration-300">
            <img
              alt="Kit Oficial de Carrera"
              width="1430"
              height="1100"
              loading="lazy"
              decoding="async"
              class="w-full h-auto max-h-[500px] object-contain mix-blend-multiply"
              src="/kit_de_carrera.webp"
            />
          </div>
        </div>
      </div>
      <!-- decorative element behind kit -->
      <div
        class="absolute top-1/2 -right-12 w-64 h-64 bg-[#ff6b00] rounded-full mix-blend-multiply filter blur-3xl opacity-30 -z-10"
      >
      </div>
    </section>

    <!-- Sponsors Section -->
    <section
      class="py-12 border-y-4 border-[#a04100] bg-[#faf3e4] my-12"
      id="patrocinadores"
    >
      <div class="bg-[#096c4b] py-6 px-8 shadow-[4px_4px_0px_0px_rgba(160,65,0,1)] slanted flex flex-col items-center gap-6">
        <div class="w-full overflow-hidden relative py-4 un-slanted">
          <div class="flex items-center gap-12 md:gap-24 animate-marquee">
            <!-- First Set of Logos -->
            <div class="flex items-center gap-12 md:gap-24 shrink-0">
              <img
                alt="Aguila"
                width="2000"
                height="1055"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/aguila_2.webp"
              />
              <img
                alt="La Feria Bonita"
                width="2000"
                height="2229"
                loading="lazy"
                decoding="async"
                class="h-20 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/feria_2.webp"
              />
              <img
                alt="Polafest"
                width="2000"
                height="827"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/polafest_logo.webp"
              />
              <img
                alt="Coca Cola"
                width="2000"
                height="628"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/coca_cola.webp"
              />
              <img
                alt="IMEBU"
                width="2000"
                height="536"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/imebu.webp"
              />
            </div>
            <!-- Second Set of Logos (for seamless looping) -->
            <div class="flex items-center gap-12 md:gap-24 shrink-0">
              <img
                alt="Aguila"
                width="2000"
                height="1055"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/aguila_2.webp"
              />
              <img
                alt="La Feria Bonita"
                width="2000"
                height="2229"
                loading="lazy"
                decoding="async"
                class="h-20 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/feria_2.webp"
              />
              <img
                alt="Polafest"
                width="2000"
                height="827"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/polafest_logo.webp"
              />
              <img
                alt="Coca Cola"
                width="2000"
                height="628"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/coca_cola.webp"
              />
              <img
                alt="IMEBU"
                width="2000"
                height="536"
                loading="lazy"
                decoding="async"
                class="h-16 object-contain opacity-80 hover:opacity-100 transition-opacity brightness-0 invert"
                src="/imebu.webp"
              />
            </div>
          </div>
        </div>
        <div class="un-slanted border-t border-white/20 pt-4 w-full flex justify-center">
          <img
            alt="Advertencia de ley: El exceso de alcohol es perjudicial para la salud. Prohíbase el expendio de bebidas embriagantes a menores de edad."
            width="2000"
            height="35"
            loading="lazy"
            decoding="async"
            class="h-6 md:h-8 object-contain brightness-0 invert opacity-90"
            src="/advertencia_1.webp"
          />
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer
    class="bg-[#096c4b] w-full px-5 md:px-16 py-6 border-t-8 border-[#a04100] relative z-20 flex flex-col gap-4"
  >
    <div class="flex flex-col md:flex-row justify-between items-center w-full gap-4">
      <div>
        <img
          src="/logosf.webp"
          alt="La Milla Cervecera"
          width="492"
          height="366"
          loading="lazy"
          decoding="async"
          class="h-16 w-auto object-contain brightness-0 invert opacity-90 hover:opacity-100 transition-opacity duration-200"
        />
      </div>
      <div class="flex flex-col md:flex-row gap-6 items-center">
        <a
          class="text-white font-['Space_Grotesk'] text-sm hover:text-[#ffb693] transition-colors uppercase tracking-wider"
          href="/terminos"
        >Términos y Condiciones</a>
        <a
          class="text-white font-['Space_Grotesk'] text-sm hover:text-[#ffb693] transition-colors uppercase tracking-wider"
          href="/privacidad"
        >Política de Privacidad</a>
        <a
          class="text-white font-['Space_Grotesk'] text-sm hover:text-[#ffb693] transition-colors uppercase tracking-wider"
          href="https://wa.me/573142907149" target="_blank" rel="noopener noreferrer">Contacto</a
        >
      </div>
      <div
